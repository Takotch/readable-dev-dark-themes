/instance/org.eclipse.mylyn.wikitext.ui/preview.css=* {\n\t font-family\:  "Noto Sans JP", Arial, Helvetica, sans-serif;\n}\n\nh1 {\n\tfont-size\: 120%;\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nh2 {\n\tfont-size\: 110%;\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nh3 {\n\tfont-size\: 105%;\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nh4 {\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nh5 {\n\tfont-size\: 90%;\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nh6 {\n\tfont-size\: 80%;\n\tfont-weight\: bold;\n\tcolor\: \#c77dbb;\n}\n\nb {\n\tfont-weight\: bold;\n}\n\nstrong {\n\tfont-weight\: bold;\n}\n\ni {\n\tfont-style\: italic;\n}\n\ncite {\n\tfont-style\: italic;\n}\n\nem {\n\tfont-style\: italic;\n}\n\nmark {\n\tbackground-color\:\#cf8e6d;\n}\n\nvar {\n\tfont-style\: italic;\n}\n\ndfn {\n\tfont-style\: italic;\n}\n\ncode {\n\tfont-family\: "BIZ UDGothic", monospace;\n\tcolor\:\#6aab73;\n}\n\npre {\n\tfont-family\: "BIZ UDGothic", monospace;\n}\n\n/* Java stack traces\npre.javaStackTrace {\n\tfont-family\: "BIZ UDGothic", monospace;\n}\n*/\n\n/* sections beginning with -- Error Details --\npre.eclipseErrorDetails {\n\tfont-family\: "BIZ UDGothic", monospace;\n}\n*/\n \nins {\n\ttext-decoration\: underline;\n}\n\ndel {\n\ttext-decoration\: line-through;\n}\n\nsup {\n\tfont-size\: smaller;\n\tvertical-align\: super;\n}\n\na {\n\ttext-decoration\: underline;\n\tcolor\: \#56a8f5;\n}\n\nsup a {\n\ttext-decoration\: none;\n}\n\nsub {\n\tfont-size\: smaller;\n\tvertical-align\: sub;\n}\n\ndt {\n\tfont-weight\: bold;\n}\n\nblockquote {\n\tcolor\: \#6aab73;\n}\n\ntt {\n\tfont-family\: "BIZ UDGothic", monospace;\t\n}\n\nq {\n\tcolor\: \#6aab73;\n}\n\nh1.editorPreview, h2.editorPreview, h3.editorPreview, h4.editorPreview {\n  padding-bottom\: 0.3em;\n  font-size\: 1.75em;\n  border-bottom\: 1px solid \#c77dbb;\n}\n\npre.editorPreview {\n  padding\: 16px;\n  overflow\: auto;\n  line-height\: 1.45;\n  background-color\: \#1f1f1f;\n  border-radius\: 3px;\n}\n  \ntable.editorPreview {\n  border-collapse\: collapse;\n  border-spacing\: 0;\n  border-color\: \#cccccc;\n}\n  \ntr.editorPreview td.editorPreview {\n  border\:1px solid \#cccccc;\n  padding\: 6px 13px;\n}\n\ntr.editorPreview th.editorPreview {\n  border\:1px solid \#ddd;\n  padding\: 6px 13px;\n  background-color\: \#1f1f1f;\n}
